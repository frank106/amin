<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sums up the executor's CSV logs: trades by setup, confirmation, hour and the odds on their
       labels, against the chart's own trades. Reads the logs only. See tests/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
